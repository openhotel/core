{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "ES2022",
    "target": "ES2022",
    "esModuleInterop": true,
    "sourceMap": false,
    "noUnusedLocals": true,
    "noEmit": true,
    "strict": true,
    "types": [],
    "lib": ["ES2022", "dom"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "include": ["index.ts", "src"],
  "exclude": ["src/**/__tests__"]
}
